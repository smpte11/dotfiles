#!/bin/bash
# dotfiles hash: {{ include "dot_config/mise/conf.d/dotfiles.toml.tmpl" | sha256sum }} {{ include ".mise-takeover" | sha256sum }}
set -euo pipefail

takeover=()
while read -r target; do
    if [ -n "$target" ] && [ -e "$HOME/$target" ] && [ ! -L "$HOME/$target" ]; then
        takeover+=("$HOME/$target")
    fi
done <{{ joinPath .chezmoi.sourceDir ".mise-takeover" | quote }}

if [ ${#takeover[@]} -gt 0 ]; then
    mise dot apply --yes --force "${takeover[@]}"
fi
mise dot apply --yes
