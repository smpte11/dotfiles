{{- $container := or (env "CODESPACES") (env "REMOTE_CONTAINERS") (env "container") (stat "/.dockerenv") (stat "/run/.containerenv") -}}

{{- $name := or (env "DOTFILES_NAME") (get . "name") "Felix Brousseau-Tremblay" -}}
{{- $profile := or (env "DOTFILES_PROFILE") (get . "profile") -}}
{{- if and (not $profile) (hasKey . "work") -}}
{{-   $profile = ternary "work" "personal" .work -}}
{{- end -}}
{{- $configured := not (not $profile) -}}
{{- if not $configured -}}
{{-   $profile = "personal" -}}
{{- end -}}

{{- $identities := (include ".chezmoidata/identities.toml" | fromToml).identities -}}
{{- if not (hasKey $identities $profile) -}}
{{-   fail (printf "unknown profile %q, expected one of: %s" $profile (keys $identities | sortAlpha | join ", ")) -}}
{{- end -}}

{{- $passwordManager := (index $identities $profile).password_manager -}}
{{- if or $container (not $configured) -}}
{{-   $passwordManager = "none" -}}
{{- end -}}

{{- if and (not $configured) (not $container) stdinIsATTY -}}
{{-   writeToStdout "Machine profile not set; run `dotfiles-setup` to configure it.\n" -}}
{{- end -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    name = {{ $name | quote }}
    profile = {{ $profile | quote }}
    work = {{ ne $profile "personal" }}
    configured = {{ $configured }}
    password_manager = {{ $passwordManager | quote }}

[edit]
command = "nvim"

[cd]
command = "zsh"

[merge]
    command = "codediff-editor"
    args = ["{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Source {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]
{{- if ne $passwordManager "none" }}

[hooks.read-source-state.pre]
    command = {{ joinPath .chezmoi.sourceDir ".install-password-manager.sh" | quote }}
    args = [{{ $passwordManager | quote }}]
{{- end }}
