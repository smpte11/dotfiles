#!/bin/sh
tuios_herdr=${HERDR_BIN_PATH:-$(dirname "${HERDR_SOCKET_PATH:?HERDR_SOCKET_PATH must point at the tuios herdr socket}")/herdr/bin/herdr}
n=$#
i=0
drop=
while [ "$i" -lt "$n" ]; do
  a=$1
  shift
  i=$((i + 1))
  if [ -n "$drop" ]; then
    drop=
    continue
  fi
  case "$a" in
    --)
      set -- "$@" "$a"
      while [ "$i" -lt "$n" ]; do
        set -- "$@" "$1"
        shift
        i=$((i + 1))
      done
      break
      ;;
    --session) drop=1; continue ;;
    --session=*) continue ;;
  esac
  set -- "$@" "$a"
done
exec "$tuios_herdr" "$@"
