{%- set games = env.HOME ~ "/.local/share/questarr/games" -%}
{%- if vars.torrents_dir is defined -%}
{%- set torrents = vars.torrents_dir -%}
{%- else -%}
{%- set torrents = env.HOME ~ "/.local/share/torrents" -%}
{%- endif -%}
[Container]
ContainerName=questarr
Image=ghcr.io/doezer/questarr:latest
Label=io.containers.autoupdate=registry
PublishPort=5000:5000
Environment=PUID=0 PGID=0 TZ=Europe/Stockholm
Volume={{ env.HOME }}/.config/questarr:/app/data:Z
Volume={{ games }}:/data:z
Volume={{ torrents }}:{{ torrents }}:z
Network=host

[Service]
ExecStartPre=/bin/mkdir -p {{ games }}
{% if vars.torrents_dir is not defined -%}
ExecStartPre=/bin/mkdir -p {{ torrents }}
{% endif -%}
Restart=always

[Install]
WantedBy=default.target
