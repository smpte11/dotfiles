#:schema https://jj-vcs.github.io/jj/latest/config-schema.json
[ui]
# SCENARIO: `jj log`, `jj diff`, `jj show`
# Used for quick, read-only viewing in the terminal.
paginate = "never"
default-command = "log"
diff-editor = ["nvim", "-c", "DiffEditor $left $right $output"]
diff-instructions = false
# 'curved' or 'square' usually looks cleaner than the default 'ascii'
graph.style = "curved"

[settings]
diff.format = "color-words"

{{ $identity := index .identities .profile -}}
[user]
name = {{ .name | quote }}
email = {{ $identity.email | quote }}
{{- if ne .password_manager "none" }}

[signing]
behavior = "own"
backend = "ssh"
key = {{ includeTemplate "identity-ssh-key" (dict "name" .profile "identity" $identity "password_manager" .password_manager) | quote }}
{{- if and (eq .password_manager "1password") (eq .chezmoi.os "darwin") }}
backends.ssh.program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- else if eq .password_manager "1password" }}
backends.ssh.program = "/opt/1Password/op-ssh-sign"
{{- end }}
{{- end }}

[revsets]
log = '''overview'''

[revset-aliases]
hidden = "none()"
# "mutable_commits(max)" = "ancestors(immutable_heads().., max)"
recent = "committer_date(after:'1 weeks ago')"
# "Show me the last week of the world, connected to the trunk"
overview = '''present(parents(trunk()..@)::@)
    | ancestors(immutable_heads().., 3) & recent
    | heads(immutable_heads()) & recent
    & ~hidden'''
# "Everything recent that isn't bot-noise, plus my current spot"
daily_work = '(trunk()..((bookmarks() | mine()) & recent) | trunk()..@) & ~author("renovate")'
# "Just my stuff and the branch I'm standing on"
active = 'trunk()..((mine() & recent) | @ | (@ & bookmarks()))'

[aliases]
tidy = ["abandon", "-r", "(empty() ~ @) ~ ::trunk()"]
fetch = ["git", "fetch"]
push = ["git", "push"]
# Re-graft the branch of current commits on trunk to the latest upstream commit
lift = ["rebase", "--source", "roots(trunk()..@)", "--destination", "trunk()"]
tug = ["bookmark", "move", "--from", "heads(::@- & bookmarks())", "--to", "@-"]
day = ["log", "-r", "daily_work"]
now = ["log", "-r", "active"]

[remotes.origin]
auto-track-bookmarks = "*"

[colors]
"working_copy change_id" = {fg = "magenta", bold = true, underline = true }
bookmarks = { fg = "magenta", reverse = false, italic = true }

[template-aliases]
# Make IDs (jj and Git) shorter
'format_short_id(id)' = 'id.shortest()'
# Relative timestamps
'format_timestamp(timestamp)' = 'timestamp.ago()'

[templates]
log = '''
label(if(current_working_copy, "working_copy"),
  concat(
    format_short_id(change_id), " ",
    author.name(), " ",
    author.timestamp().format("%Y-%m-%d %H:%M"), " ",
    bookmarks,
    "\n",
    description.first_line(),
  )
)
'''
log_node = '''
label("node",
  coalesce(
    if(!self, label("elided", "┊")),
    if(current_working_copy, label("working_copy", "@")),
    if(empty, label("working_copy empty", "⋅")),
    if(conflict, label("conflict", "×")),
    if(bookmarks.any(|b| b.name() == "main" || b.name() == "master"), label("trunk_node", "◉")),
    if(immutable, label("immutable", "●")),
    label("normal", "○")
  )
)
'''
