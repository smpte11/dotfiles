# firstmate launcher - herdr backend.

export def --env _fm-launch [harness: string] {
    let fm_src = $"($env.HOME)/.local/share/firstmate"
    let fm_state = $"($env.HOME)/.local/state/firstmate"
    let herdr_socket = if "XDG_RUNTIME_DIR" in $env {
        $"($env.XDG_RUNTIME_DIR)/tuios/tuios.sock.herdr"
    } else {
        $"/tmp/tuios-(id -u)/tuios.sock.herdr"
    }

    cd $fm_src
    with-env {
        FM_HOME: $fm_state
        FM_BACKEND: herdr
        HERDR_SOCKET_PATH: $herdr_socket
        PATH: ($env.PATH | prepend $"($env.HOME)/.local/share/firstmate-tuios/bin")
    } {
        match $harness {
            "claude" => { ^claude }
            "pi" => { ^pi }
            "grok" => { ^grok --trust }
            _ => { error make { msg: $"unknown harness: ($harness)" } }
        }
    }
}

export def --env fm [] {
    _fm-launch {{ if hasSuffix "@kivra.com" .email -}}"claude"{{- else -}}"pi"{{- end }}
}

export def --env fm-claude [] { _fm-launch "claude" }
export def --env fm-pi [] { _fm-launch "pi" }
export def --env fm-grok [] { _fm-launch "grok" }
