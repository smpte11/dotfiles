{
  "name": "elixir-lsp",
  "description": "Elixir language server (Expert) for code intelligence",
  "version": "1.0.0",
  "author": {
    "name": "Felix Brousseau-Tremblay",
    "email": "{{ vars.email }}"
  },
  "lspServers": {
    "expert": {
      "command": "expert",
      "args": ["--stdio"],
      "extensionToLanguage": {
        ".ex": "elixir",
        ".exs": "elixir",
        ".heex": "phoenix-heex"
      }
    }
  }
}
