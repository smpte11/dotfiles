{
  "name": "scala-lsp",
  "description": "Scala language server (Metals) for code intelligence",
  "version": "1.0.0",
  "author": {
    "name": "Felix Brousseau-Tremblay",
    "email": "{{ vars.email }}"
  },
  "lspServers": {
    "metals": {
      "command": "metals",
      "extensionToLanguage": {
        ".scala": "scala",
        ".sc": "scala",
        ".sbt": "scala"
      }
    }
  }
}
