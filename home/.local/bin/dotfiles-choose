#!/bin/sh
set -eu

dotfiles="$HOME/.dotfiles"
manifest="$dotfiles/modules.toml"

[ -f "$manifest" ] || { echo "missing $manifest" >&2; exit 1; }

gum() {
    if [ -n "${DOTFILES_GUM:-}" ]; then
        $DOTFILES_GUM "$@"
    else
        mise exec gum@latest -- gum "$@"
    fi
}

manifest_rows() {
    awk '
        /^\[module\.[A-Za-z0-9_-]+\]$/ {
            name = $0
            sub(/^\[module\./, "", name)
            sub(/\]$/, "", name)
            order[++count] = name
        }
        /^description = "/ {
            line = $0
            sub(/^description = "/, "", line)
            sub(/"$/, "", line)
            desc[name] = line
        }
        /^modules = \[/ {
            line = $0
            sub(/^modules = \[/, "", line)
            sub(/\].*$/, "", line)
            gsub(/[" ]/, "", line)
            mods[name] = line
        }
        END {
            for (i = 1; i <= count; i++) {
                name = order[i]
                print name "\t" desc[name] "\t" mods[name]
            }
        }
    ' "$manifest"
}

picker_options() {
    tab=$(printf '\t')
    manifest_rows | while IFS="$tab" read -r name desc mods; do
        printf '%s - %s\n' "$name" "$desc"
    done
}

label_for_module() {
    manifest_rows | awk -F'\t' -v m="$1" '
        $1 == m { exact = $1 " - " $2 }
        $3 ~ ("(^|,)" m "(,|$)") && listed == "" { listed = $1 " - " $2 }
        END { if (exact != "") print exact; else print listed }
    '
}

modules_for_labels() {
    printf '%s\n' "$1" | while read -r label; do
        if [ -n "$label" ]; then
            name=${label%% - *}
            manifest_rows | awk -F'\t' -v n="$name" '$1 == n { print $3; exit }'
        fi
    done | tr ',' '\n' | awk 'NF && !seen[$0]++' | paste -sd, -
}

edit_profile() {
    miserc="$dotfiles/home/.config/mise/miserc.local.toml"
    editor=${EDITOR:-vi}
    if ! "$editor" "$miserc"; then
        echo "setup aborted" >&2
        exit 1
    fi
    sed -n 's/^env = \[\(.*\)\]$/\1/p' "$miserc" 2>/dev/null | tr -d '" ' | tr ',' '\n' | sed '/^$/d' | paste -sd, -
}

expand_modules() {
    printf '%s\n' "$1" | tr ',' '\n' | while read -r name; do
        if [ -n "$name" ]; then
            mods=$(manifest_rows | awk -F'\t' -v n="$name" '$1 == n { print $3; exit }')
            printf '%s\n' "${mods:-$name}"
        fi
    done | tr ',' '\n' | awk 'NF && !seen[$0]++' | paste -sd, -
}

main() {
    if [ "${1:-}" = --expand ]; then
        expand_modules "${2:-}"
        return
    fi
    if [ "${1:-}" = --edit ]; then
        edit_profile
        return
    fi
    current=${1:-}
    selected=
    for m in $(printf '%s' "$current" | tr ',' ' '); do
        if [ "$m" = ssh ]; then
            continue
        fi
        label=$(label_for_module "$m")
        if [ -n "$label" ]; then
            selected=${selected:+$selected,}$label
        fi
    done

    set --
    if [ -n "$selected" ]; then
        set -- --selected "$selected"
    fi

    if ! chosen=$(picker_options | gum choose --no-limit --header "Modules for this machine" "$@"); then
        echo "setup aborted" >&2
        exit 1
    fi

    modules=$(modules_for_labels "$chosen")
    if [ -n "$modules" ]; then
        prompt="Bootstrap this machine with modules: $modules?"
    else
        prompt="Bootstrap this machine with no extra modules?"
    fi
    if ! gum confirm "$prompt"; then
        echo "setup aborted" >&2
        exit 1
    fi
    printf '%s\n' "$modules"
}

main "$@"
