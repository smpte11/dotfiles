#!/bin/sh
set -eu

dotfiles="$HOME/.dotfiles"
config_dir="home/.config/mise"
miserc="$dotfiles/$config_dir/miserc.local.toml"
pass="$HOME/.local/bin/pass-cli"

machine_id="$(cat /etc/machine-id 2>/dev/null || true)"
if [ -n "$machine_id" ]; then
    export MACHINE_ID="$machine_id"
fi

in_container() {
    [ -n "${CODESPACES:-}${REMOTE_CONTAINERS:-}${container:-}" ] || [ -f /.dockerenv ] || [ -f /run/.containerenv ]
}

gum() {
    if [ -n "${DOTFILES_GUM:-}" ]; then
        $DOTFILES_GUM "$@"
    else
        mise exec gum@latest -- gum "$@"
    fi
}

choose_modules() {
    "$dotfiles/home/.local/bin/dotfiles-choose" "$(read_modules | paste -sd, -)"
}

read_modules() {
    [ -f "$miserc" ] || return 0
    sed -n 's/^env = \[\(.*\)\]$/\1/p' "$miserc" | tr -d '" ' | tr ',' '\n' | sed '/^$/d'
}

check_machine_id() {
    if in_container; then return 0; fi
    [ -n "$machine_id" ] || return 0
    local recorded
    recorded="$(sed -n 's/^machine_id = "\(.*\)"$/\1/p' "$miserc" 2>/dev/null || true)"
    if [ -n "$recorded" ] && [ "$recorded" != "$machine_id" ]; then
        echo "refusing to bootstrap: $miserc records machine_id $recorded, but this machine is $machine_id" >&2
        exit 1
    fi
}

deployed_codestral_key() {
    sed -n 's/^CODESTRAL_API_KEY=//p' "$HOME/.config/codestral/env" 2>/dev/null || true
}

unapply_removed_modules() {
    for module in $1; do
        case "$2" in
        *",$module,"*) ;;
        *) CODESTRAL_API_KEY="${CODESTRAL_API_KEY:-$(deployed_codestral_key)}" mise bootstrap unapply "$module" --yes ;;
        esac
    done
}

with_ssh() {
    case ",$1," in
    *,ssh,*) echo "$1" ;;
    *,base,* | *,work,*) echo "$1,ssh" ;;
    *) echo "$1" ;;
    esac
}

write_modules() {
    export_secrets
    modules="$(with_ssh "$(printf '%s' "$1" | tr -d ' ' | sed 's/,*$//')")"
    unapply_removed_modules "$(read_modules | paste -sd' ' -)" ",$modules,"
    list="$(printf '%s' "$modules" | tr ',' '\n' | sed '/^$/d; s/.*/"&"/' | paste -sd, -)"
    printf 'env = [%s]\n' "$list" >"$miserc"
    if [ -n "$machine_id" ] && ! in_container; then
        printf 'machine_id = "%s"\n' "$machine_id" >>"$miserc"
    fi
}

ensure_ssh_module() {
    current="$(read_modules | paste -sd, -)"
    [ "$(with_ssh "$current")" = "$current" ] || write_modules "$current"
}

proton_login() {
    if [ ! -x "$pass" ]; then
        curl -fsSL https://proton.me/download/pass-cli/install.sh | mise exec jq@latest -- bash
    fi
    "$pass" info >/dev/null 2>&1 && return 0
    if [ -t 0 ]; then
        "$pass" login
    else
        echo "pass-cli is not logged in; run 'pass-cli login', then 'mise run dotfiles:update'" >&2
    fi
}

media_secret() {
    local var=$1 item=$2 fallback=$3 val
    val="$("$pass" item view "$item" 2>/dev/null || true)"
    if [ -z "$val" ] && [ -n "$fallback" ] && [ -f "$fallback" ]; then
        val="$(sed -n 's/.*<ApiKey>\([^<]*\)<\/ApiKey>.*/\1/p' "$fallback")"
    fi
    if [ -z "$val" ]; then
        eval "val=\${$var:-}"
    fi
    export "$var=$val"
    return 0
}

export_netfelix_secrets() {
    read_modules | grep -qxE 'media|gaming' || return 0
    proton_login
    media_secret SONARR_API_KEY 'pass://Media/Netfelix/SONARR_API_KEY' "$HOME/.config/sonarr/config.xml"
    media_secret RADARR_API_KEY 'pass://Media/Netfelix/RADARR_API_KEY' "$HOME/.config/radarr/config.xml"
    media_secret PROWLARR_API_KEY 'pass://Media/Netfelix/PROWLARR_API_KEY' "$HOME/.config/prowlarr/config.xml"
    media_secret QUESTARR_API_KEY 'pass://Media/Netfelix/QUESTARR_API_KEY' ""
    media_secret QBIT_USERNAME 'pass://Media/Netfelix/QBIT_USERNAME' ""
    media_secret QBIT_PASSWORD 'pass://Media/Netfelix/QBIT_PASSWORD' ""
    media_secret YTS_API_URL 'pass://Media/Netfelix/YTS_API_URL' ""
}

export_secrets() {
    if read_modules | grep -qx base; then
        proton_login
        key="$("$pass" item view 'pass://Personal/Codestral/API Key' 2>/dev/null || true)"
        CODESTRAL_API_KEY="${key:-${CODESTRAL_API_KEY:-}}"
        export CODESTRAL_API_KEY
    fi
    export_netfelix_secrets
    if read_modules | grep -qx proton-pass; then
        proton_login
    fi
}

check_machine_id

if [ -n "${DOTFILES_ENV+set}" ]; then
    write_modules "$DOTFILES_ENV"
elif [ -t 0 ] && ! in_container; then
    mode=pick
    if gum confirm "Edit the profile file ($config_dir/miserc.local.toml) in ${EDITOR:-editor} instead of picking modules?"; then
        mode=edit
    elif [ $? -gt 1 ]; then
        echo "setup aborted" >&2
        exit 1
    fi
    if [ "$mode" = edit ]; then
        if ! modules=$("$dotfiles/home/.local/bin/dotfiles-choose" --edit); then exit 1; fi
    else
        if ! modules=$(choose_modules); then exit 1; fi
    fi
    write_modules "$modules"
fi

if [ "${1:-}" = update ]; then
    shift
    ensure_ssh_module
    export_secrets
    exec mise bootstrap --update --prune-dotfiles --yes "$@"
fi

ensure_ssh_module
export_secrets

exec mise bootstrap --from "$(git -C "$dotfiles" remote get-url origin)" \
    --from-dir "$dotfiles" --config-dir "$config_dir" --prune-dotfiles --yes "$@"
