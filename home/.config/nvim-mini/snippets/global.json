{
 "markdown": {
		"Note title": {
			"prefix": "nt",
			"body": ["# ${1:Title}", "", "## ${2:Section}", "$0"]
		},
		"Task list": {
			"prefix": "tlist",
			"body": ["- [ ] ${1:Task}", "- [ ] ${2:Task}", "$0"]
		},
		"Table": {
			"prefix": "tbl",
			"body": [
				"| ${1:Column} | ${2:Column} |",
				"| --- | --- |",
				"| ${3:Cell} | ${4:Cell} |",
				"$0"
			]
		},
		"Code block": {
			"prefix": "code",
			"body": ["```${1:language}", "$0", "```"]
		},
		"zk link": {
			"prefix": "zkl",
			"body": ["[${1:Title}](../notes/${2:slug}.md)$0"]
		}
	},
	"yaml": {
		"Key-value": {
			"prefix": "kv",
			"body": ["${1:key}: ${2:value}$0"]
		},
		"List item": {
			"prefix": "li",
			"body": ["- ${1:item}$0"]
		}
	},
	"toml": {
		"Section": {
			"prefix": "sec",
			"body": ["[${1:section}]", "$0"]
		},
		"Key-value": {
			"prefix": "kv",
			"body": ["${1:key} = ${2:\"value\"}$0"]
		}
	}
}
