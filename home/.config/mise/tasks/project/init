#!/bin/sh
#MISE description="Add the toolchain, language server and debug adapter of one or more languages to the mise.toml of this project"
#MISE raw=true
#MISE dir="{{cwd}}"
#USAGE arg "<lang>..." help="Languages to set up" {
#USAGE   choices "elixir" "erlang" "go" "python" "rust" "scala"
#USAGE }
set -eu

for lang in "$@"; do
    case "$lang" in
    elixir) mise use erlang elixir expert elixir-ls ;;
    erlang)
        mise use erlang rebar github:WhatsApp/erlang-language-platform github:WhatsApp/edb
        profile='{profiles, [{test, [{erl_opts, [debug_info, beam_debug_info, beam_debug_stack]}]}]}.'
        if [ ! -f rebar.config ] || grep -q beam_debug_info rebar.config; then
            :
        elif grep -q '{profiles' rebar.config; then
            echo "Add debug_info, beam_debug_info and beam_debug_stack to erl_opts of the test profile in rebar.config" >&2
        else
            printf '%s\n' "$profile" >>rebar.config
            echo "Added the edb debug profile to rebar.config"
        fi
        ;;
    go) mise use go go:golang.org/x/tools/gopls go:github.com/go-delve/delve/cmd/dlv ;;
    python) mise use python uv ty pipx:debugpy ;;
    rust) mise use rust rust-analyzer ;;
    scala)
        mise use java sbt coursier
        if grep -q '\.bin/metals' mise.toml; then
            :
        elif grep -q -e '^\[env\]' -e '^\[hooks\]' mise.toml; then
            echo 'Add _.path = ["{{config_root}}/.bin"] to [env] and a postinstall hook that runs cs install --install-dir .bin metals to [hooks] in mise.toml' >&2
        else
            cat >>mise.toml <<'EOF'

[env]
_.path = ["{{config_root}}/.bin"]

[hooks]
postinstall = '[ -x "{{config_root}}/.bin/metals" ] || cs install --install-dir "{{config_root}}/.bin" metals'
EOF
        fi
        if ! grep -qx '\.bin/' .gitignore 2>/dev/null; then
            echo '.bin/' >>.gitignore
        fi
        mise install
        ;;
    *)
        echo "Unknown language: $lang" >&2
        exit 1
        ;;
    esac
done
