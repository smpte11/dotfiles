{{ if eq .password_manager "proton" -}}
#!/bin/bash
{{ if eq .chezmoi.os "darwin" -}}
# plist hash: {{ include "Library/LaunchAgents/com.felbro.proton-pass-ssh-agent.plist.tmpl" | sha256sum }}
set -euo pipefail

label="com.felbro.proton-pass-ssh-agent"
uid="$(id -u)"

mkdir -p "$HOME/.ssh"
launchctl bootout "gui/$uid/$label" 2>/dev/null || true
launchctl bootstrap "gui/$uid" "$HOME/Library/LaunchAgents/$label.plist"
{{- else -}}
# unit hash: {{ include "dot_config/systemd/user/proton-pass-ssh-agent.service" | sha256sum }}
set -euo pipefail

if [ ! -d /run/systemd/system ]; then
    echo "systemd is not running; skipped loading units" >&2
    exit 0
fi

systemctl --user daemon-reload
systemctl --user enable --now proton-pass-ssh-agent.service
systemctl --user restart proton-pass-ssh-agent.service
{{- end }}
{{ end -}}
