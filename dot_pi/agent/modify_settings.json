{{- /* chezmoi:modify-template */ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $calm := "~/.local/share/firstmate/.pi/extensions/fm-calm.ts" -}}
{{- $extensions := list -}}
{{- if hasKey $settings "extensions" -}}
{{-   $extensions = $settings.extensions -}}
{{- end -}}
{{- if not (has $calm $extensions) -}}
{{-   $extensions = append $extensions $calm -}}
{{- end -}}
{{- $_ := set $settings "extensions" $extensions -}}
{{ toPrettyJson $settings | trim }}
