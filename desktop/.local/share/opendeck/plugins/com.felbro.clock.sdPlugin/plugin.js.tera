{%- set themes = read_toml(path=mise_config_dir ~ "/themes.toml") -%}
{%- set t = themes[vars.theme] -%}
const colors = {
  background: "{{ t.background }}",
  sky: "{{ t.palette.blue }}",
  neon: "{{ t.palette.magenta }}",
  glow: "{{ t.palette.bright_magenta }}",
  sunTop: "{{ t.palette.yellow }}",
  sunBottom: "{{ t.palette.red }}",
  time: "{{ t.palette.cyan }}",
  date: "{{ t.palette.white }}",
};

const width = 248;
const height = 58;
const pixel = 2;
const horizon = 38;
const sun = { x: 168, r: 28 };

const large = {
  0: ["01110", "10001", "10011", "10101", "11001", "10001", "01110"],
  1: ["00100", "01100", "00100", "00100", "00100", "00100", "01110"],
  2: ["01110", "10001", "00001", "00010", "00100", "01000", "11111"],
  3: ["11111", "00010", "00100", "00010", "00001", "10001", "01110"],
  4: ["00010", "00110", "01010", "10010", "11111", "00010", "00010"],
  5: ["11111", "10000", "11110", "00001", "00001", "10001", "01110"],
  6: ["00110", "01000", "10000", "11110", "10001", "10001", "01110"],
  7: ["11111", "00001", "00010", "00100", "01000", "01000", "01000"],
  8: ["01110", "10001", "10001", "01110", "10001", "10001", "01110"],
  9: ["01110", "10001", "10001", "01111", "00001", "00010", "01100"],
  ":": ["0", "0", "1", "0", "1", "0", "0"],
};

const small = {
  0: ["111", "101", "101", "101", "111"],
  1: ["010", "110", "010", "010", "111"],
  2: ["111", "001", "111", "100", "111"],
  3: ["111", "001", "111", "001", "111"],
  4: ["101", "101", "111", "001", "001"],
  5: ["111", "100", "111", "001", "111"],
  6: ["111", "100", "111", "101", "111"],
  7: ["111", "001", "010", "010", "010"],
  8: ["111", "101", "111", "101", "111"],
  9: ["111", "101", "111", "001", "111"],
  "-": ["000", "000", "111", "000", "000"],
  A: ["010", "101", "111", "101", "101"],
  D: ["110", "101", "101", "101", "110"],
  E: ["111", "100", "110", "100", "111"],
  F: ["111", "100", "110", "100", "100"],
  H: ["101", "101", "111", "101", "101"],
  I: ["111", "010", "010", "010", "111"],
  M: ["10001", "11011", "10101", "10001", "10001"],
  N: ["1001", "1101", "1011", "1001", "1001"],
  O: ["111", "101", "101", "101", "111"],
  R: ["110", "101", "110", "101", "101"],
  S: ["111", "100", "111", "001", "111"],
  T: ["111", "010", "010", "010", "010"],
  U: ["101", "101", "101", "101", "111"],
  W: ["10001", "10001", "10101", "11011", "10001"],
};

const rgb = (hex) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
const mix = (a, b, amount) => {
  const [from, to] = [rgb(a), rgb(b)];
  return `#${from.map((value, i) => Math.round(value + (to[i] - value) * amount).toString(16).padStart(2, "0")).join("")}`;
};
const steps = (stops, amount) => {
  const position = Math.min(amount, 0.9999) * (stops.length - 1);
  const index = Math.floor(position);
  return mix(stops[index], stops[index + 1], position - index);
};

const rect = (x, y, w, h, fill) => `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${fill}"/>`;

const textWidth = (font, text, scale) => [...text].reduce((sum, char) => sum + (font[char][0].length + 1) * scale, -scale);

const text = (font, value, x, y, scale, fill) => {
  let path = "";
  let cursor = x;
  for (const char of value) {
    font[char].forEach((row, dy) => {
      [...row].forEach((on, dx) => {
        if (on === "1") path += `M${cursor + dx * scale} ${y + dy * scale}h${scale}v${scale}h-${scale}z`;
      });
    });
    cursor += (font[char][0].length + 1) * scale;
  }
  return `<path d="${path}" fill="${fill}"/>`;
};

const stars = [
  [6, 4], [44, 2], [70, 8], [96, 4], [118, 12], [130, 2], [142, 8], [196, 6], [214, 30], [236, 26], [124, 26],
];

const scene = (() => {
  const parts = [];
  const bands = 6;
  for (let y = 0; y < horizon; y += pixel) {
    const band = Math.floor((y / horizon) * bands) / (bands - 1);
    parts.push(rect(0, y, width, pixel, steps([colors.background, mix(colors.background, colors.sky, 0.5), mix(colors.background, colors.neon, 0.6)], band)));
  }
  for (const [x, y] of stars) parts.push(rect(x, y, pixel, pixel, mix(colors.date, colors.sky, 0.3)));
  const gaps = [[24, 26], [29, 31], [33, 36]];
  for (let y = horizon - sun.r; y < horizon; y += pixel) {
    if (gaps.some(([from, to]) => y >= from && y < to)) continue;
    const half = Math.floor(Math.sqrt(sun.r ** 2 - (horizon - y) ** 2) / pixel) * pixel;
    parts.push(rect(sun.x - half, y, half * 2, pixel, mix(colors.sunTop, colors.sunBottom, (y - (horizon - sun.r)) / sun.r)));
  }
  parts.push(rect(0, horizon, width, height - horizon, mix(colors.background, "#000000", 0.35)));
  for (let offset = -4; offset <= 2; offset++) {
    parts.push(`<line x1="${sun.x}" y1="${horizon}" x2="${sun.x + offset * 64}" y2="${height}" stroke="${colors.neon}" stroke-width="${pixel}"/>`);
  }
  for (const y of [horizon + 4, horizon + 9, horizon + 16]) parts.push(rect(0, y, width, pixel, colors.neon));
  parts.push(rect(0, horizon, width, pixel, colors.glow));
  return parts.join("");
})();

const pad = (value) => String(value).padStart(2, "0");

const image = (now) => {
  const time = `${pad(now.getHours())}:${pad(now.getMinutes())}`;
  const day = now.toLocaleDateString("en", { weekday: "short" }).toUpperCase();
  const date = `${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  const dayX = width - 6 - textWidth(small, day, pixel);
  const dateX = width - 6 - textWidth(small, date, pixel);
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" shape-rendering="crispEdges">${scene}${text(large, time, 10, 7, 4, colors.neon)}${text(large, time, 8, 5, 4, colors.time)}${text(small, day, dayX + pixel, 6, pixel, colors.background)}${text(small, day, dayX, 4, pixel, colors.date)}${text(small, date, dateX + pixel, 18, pixel, colors.background)}${text(small, date, dateX, 16, pixel, colors.date)}</svg>`;
  return `data:image/svg+xml;base64,${Buffer.from(svg).toString("base64")}`;
};

const args = {};
for (let i = 2; i < process.argv.length; i += 2) args[process.argv[i].slice(1)] = process.argv[i + 1];

const contexts = new Set();
const ws = new WebSocket(`ws://127.0.0.1:${args.port}`);

const render = () => {
  if (ws.readyState !== WebSocket.OPEN) return;
  const img = image(new Date());
  for (const context of contexts) ws.send(JSON.stringify({ event: "setImage", context, payload: { image: img, target: 0 } }));
};

const tick = () => {
  render();
  setTimeout(tick, 60_000 - (Date.now() % 60_000));
};

ws.addEventListener("open", () => {
  ws.send(JSON.stringify({ event: args.registerEvent, uuid: args.pluginUUID }));
});

ws.addEventListener("message", ({ data }) => {
  const { event, context } = JSON.parse(data);
  if (event === "willAppear") {
    contexts.add(context);
    render();
  } else if (event === "willDisappear") {
    contexts.delete(context);
  }
});

ws.addEventListener("close", () => process.exit(0));

tick();
