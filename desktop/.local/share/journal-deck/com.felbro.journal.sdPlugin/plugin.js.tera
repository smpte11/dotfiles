{%- set themes = read_toml(path=mise_config_dir ~ "/themes.toml") -%}
{%- set t = themes[vars.theme] -%}
const { execFile } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const home = os.homedir();
const stateDir = path.join(process.env.XDG_STATE_HOME || path.join(home, ".local/state"), "journal");
const pendingFile = path.join(stateDir, "pending");
const opener = path.join(home, ".local/bin/journal-open");

const colors = {
  background: "{{ t.background }}",
  foreground: "{{ t.foreground }}",
  pending: "{{ t.ribbon_bg }}",
  pendingText: "{{ t.ribbon_fg }}",
};

const args = {};
for (let i = 2; i < process.argv.length; i += 2) args[process.argv[i].slice(1)] = process.argv[i + 1];

const contexts = new Set();
const ws = new WebSocket(`ws://127.0.0.1:${args.port}`);

const send = (event, context, payload) => ws.send(JSON.stringify({ event, context, payload }));

const image = (pending) => {
  const now = new Date();
  const day = now.toLocaleDateString("en", { weekday: "short" });
  const date = `${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
  const bg = pending ? colors.pending : colors.background;
  const fg = pending ? colors.pendingText : colors.foreground;
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 144 144">
    <rect width="144" height="144" rx="16" fill="${bg}"/>
    <text x="72" y="58" text-anchor="middle" font-family="sans-serif" font-size="30" fill="${fg}">${day}</text>
    <text x="72" y="104" text-anchor="middle" font-family="sans-serif" font-size="40" font-weight="bold" fill="${fg}">${date}</text>
  </svg>`;
  return `data:image/svg+xml;base64,${Buffer.from(svg).toString("base64")}`;
};

const render = () => {
  if (ws.readyState !== WebSocket.OPEN) return;
  const img = image(fs.existsSync(pendingFile));
  for (const context of contexts) send("setImage", context, { image: img, target: 0 });
};

const open = (context) =>
  execFile(opener, (error) => {
    send(error ? "showAlert" : "showOk", context);
    render();
  });

ws.addEventListener("open", () => {
  ws.send(JSON.stringify({ event: args.registerEvent, uuid: args.pluginUUID }));
});

ws.addEventListener("message", ({ data }) => {
  const { event, context } = JSON.parse(data);
  if (event === "willAppear") {
    contexts.add(context);
    render();
  } else if (event === "willDisappear") {
    contexts.delete(context);
  } else if (event === "keyDown") {
    open(context);
  }
});

ws.addEventListener("close", () => process.exit(0));

fs.mkdirSync(stateDir, { recursive: true });
fs.watch(stateDir, render);
setInterval(render, 60_000);
