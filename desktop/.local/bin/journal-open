#!/bin/sh
set -eu

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

kind="$(mise vars profile)"
session=notes
window=journal
state="${XDG_STATE_HOME:-$HOME/.local/state}/journal"

mkdir -p "$state"

note="$(zk daily "$kind" --print-path)"

has_session() {
  tuios list-sessions --json 2>/dev/null | jq -e --arg s "$session" 'any(.[]; .name == $s)' >/dev/null
}

edit_in_window() {
  pid="$(tuios get-window -s "$session" "$window" --json 2>/dev/null | jq -r '.pid // empty')"
  [ -n "$pid" ] && nvim --server "$state/$pid.sock" --remote-send "<Cmd>edit $note<CR>" 2>/dev/null
}

has_session || tuios new "$session" --detach --cwd "$HOME/notebook" >/dev/null

if ! edit_in_window; then
  tuios close-window -s "$session" "$window" >/dev/null 2>&1 || true
  rm -f "$state"/*.sock
  tuios new-window -s "$session" "$window" --cwd "$HOME/notebook" --no-focus -- \
    sh -c "exec nvim --listen \"\$1/\$\$.sock\" \"\$2\"" sh "$state" "$note" >/dev/null
fi

tuios focus-window -s "$session" "$window" >/dev/null

case "$(uname -s)" in
Darwin)
  if tuios list-clients --json | jq -e 'map(select(.session != "")) | length > 0' >/dev/null; then
    tuios switch-session "$session" >/dev/null
    open -a Ghostty
  else
    open -na Ghostty --args -e tuios attach "$session"
  fi
  ;;
*)
  if command -v konsole >/dev/null 2>&1; then
    systemd-run --user --collect --quiet -- konsole -e "$(command -v tuios)" attach "$session"
  else
    systemd-run --user --collect --quiet -- ptyxis -- "$(command -v tuios)" attach "$session"
  fi
  ;;
esac

rm -f "$state/pending"
