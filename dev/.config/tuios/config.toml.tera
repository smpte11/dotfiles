{%- set themes = read_toml(path=mise_config_dir ~ "/themes.toml") -%}
{%- set t = themes[vars.theme] -%}
{%- set bg = t.background -%}
{%- set p = t.palette -%}
[appearance]
# theme='' + background='off' ride the terminal palette (switch-theme via Ghostty).
theme = ''
background = 'off'
dockbar_position = 'top'
whichkey_enabled = true
nvim_navigation = true
git_dirty = false
master_ratio = 70
border_focused_color = '{{ p.bright_green }}'
border_unfocused_color = '{{ p.bright_black }}'
window_title_style = 'plain'
dock_pill_caps = false
dock_prefix_indicator = 'badge'

[appearance.selection]
bg = '{{ t.selection_bg }}'
fg = '{{ t.selection_fg }}'
search_bg = '{{ p.yellow }}'
search_fg = '{{ bg }}'
match_bg = '{{ p.bright_yellow }}'
match_fg = '{{ bg }}'
cursor_bg = '{{ t.cursor }}'
cursor_fg = '{{ bg }}'

[appearance.sidebar]
width = 32
density = 'roomy'
header_style = 'plain'
header_case = 'uppercase'
sections = 'agents:45,sessions:20,files:25,terminals'
subagent_rows = 'tree'
subagent_collapse = 'expanded'
subagent_fields = 'mark,name,time'
subagent_max_rows = 5
subagent_hide_finished = '30s'

[appearance.sidebar.agent_row]
tokens = ['need', 'harness', 'name', 'elapsed', 'context', 'subagents', 'now']

[[appearance.sidebar.agent_row.elapsed.rule]]
gt = 30
fg = 'warning'

[dock.tabs]
style = 'flat'

[keybindings]
leader_key = 'ctrl+space'

[keybindings.global]
command_palette = ['opt+p']

[keybindings.prefix_mode]
prefix_prev_window = ['shift+tab']
launcher = []
'open_menu:pane' = ['p']
'open_menu:agents' = ['a']

[keybindings.workspace_prefix]
new_workspace = ['n']
last_workspace = ['l']
next_workspace = [']']
prev_workspace = ['[']
close_workspace = ['x']
prefix_workspace_switcher = ['w']

[keybindings.menus.pane]
title = 'Pane'

[keybindings.menus.pane.keys]
prefix_split_vertical = ['v']
prefix_split_horizontal = ['s']
prefix_close_window = ['x']
prefix_fullscreen = ['z']
prefix_rename_window = ['r']
prefix_equalize_splits = ['=']
prefix_rotate_split = ['o']
mark_pane = ['m']
break_pane = ['b']
'open_menu:resize' = ['R']

[keybindings.menus.resize]
title = 'Resize'
sticky = true

[keybindings.menus.resize.keys]
resize_pane_left_5 = ['h']
resize_pane_down_5 = ['j']
resize_pane_up_5 = ['k']
resize_pane_right_5 = ['l']

[keybindings.menus.agents]
title = 'Agents'

[keybindings.menus.agents.keys]
prefix_inbox = ['i']
prefix_mail = ['m']
prefix_next_attention = ['o']
prefix_next_finished = ['f']
prefix_jump_notif = ['j']
prefix_last_message = ['n']
prefix_review = ['v']
prefix_agents_settings = ['s']

[keybindings.terminal_mode]
terminal_next_window = ['opt+tab']
terminal_prev_window = ['opt+shift+tab']
terminal_focus_left = ['opt+h']
terminal_focus_down = ['opt+j']
terminal_focus_up = ['opt+k']
terminal_focus_right = ['opt+l']

[startup]
daemon = true

[agents.permissions]
mode = 'strict'
grants = ['admin', 'respond']

[spotlight]
enabled = false
